# Names and shapes only — never commit a value.
#
# The vault (TRNSF-600) is the source; the deploy pipeline resolves it and injects these as
# Railway variables. The running app reads the environment only (design.md §7).

DATABASE_URL=postgresql://user:password@host:5432/database

# Model gateway — OpenRouter, server-side only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_FALLBACK_MODELS=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=https://assistant.example.com
OPENROUTER_APP_TITLE=Stelic Assistant

# Zoho OAuth — the EXISTING Stelic client with this app's redirect URI added (task 0.3)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://assistant.example.com/api/auth/callback
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_PROJECTS_API_DOMAIN=https://projectsapi.zoho.com
ZOHO_PORTAL_ID=911636649

# The vault TRNSF-600 refresh token. Reads only — writes run on the signed-in user's token.
ZOHO_SERVICE_REFRESH_TOKEN=

# 32 bytes, base64 or 64-char hex: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

SESSION_COOKIE_NAME=stelic_session
SESSION_MAX_AGE_DAYS=30

# Pending product decisions — proposal.md open questions 5 and 6.
# There is no daily hour cap (open question 4, resolved: abandoned).
BACKDATE_WARN_DAYS=14
DEFAULT_BILL_STATUS=Billable

# What a brand-new user row starts with; the browser reports the real one (task 5.10).
DEFAULT_TIMEZONE=America/New_York

# The last date the invoice pipeline has already billed, ISO YYYY-MM-DD.
# Undo refuses on or before it, so deleting a log cannot orphan a pointer in the billing
# app's invoiced_logs ledger (task 6.10). Unset means no lock.
# BILLING_LOCKED_THROUGH=2026-06-30
